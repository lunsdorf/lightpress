{
	"name": "lightpress",
	"version": "2.0.0-beta.3",
	"description": "A thin composable HTTP handler interface around NodeJS native server listener.",
	"type": "module",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		},
		"./utility": {
			"types": "./lib/utility/index.d.ts",
			"import": "./lib/utility/index.js"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"prebuild": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
		"build": "tsc",
		"check-format": "biome check .",
		"check-types": "tsc --noEmit",
		"format": "biome check --write .",
		"prepare": ".githooks/setup.sh",
		"prepublishOnly": "npm run check-format && npm run test && npm run build",
		"test": "node --test"
	},
	"files": [
		"lib/**/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lunsdorf/lightpress.git"
	},
	"keywords": [
		"composable",
		"express",
		"http",
		"lightpress",
		"server"
	],
	"license": "MIT",
	"author": "Lunsdorf <lunsdorf@users.noreply.github.com>",
	"homepage": "https://github.com/lunsdorf/lightpress#readme",
	"bugs": {
		"url": "https://github.com/lunsdorf/lightpress/issues"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^24.10.13",
		"typescript": "^7.0.2"
	}
}
